{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "parent_version",
    "provider",
    "provider_version",
    "model_identity",
    "diagnosis_refs",
    "atomic_edits",
    "new_tests",
    "edit_budget",
    "created_at"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_version": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "provider_version": {
      "type": "string",
      "minLength": 1
    },
    "model_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "diagnosis_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "atomic_edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "target_path",
          "hypothesis",
          "expected_metric",
          "patch"
        ],
        "properties": {
          "component": {
            "enum": [
              "prompt",
              "tool_policy",
              "context",
              "office_script",
              "verifier_rule",
              "candidate_test"
            ]
          },
          "target_path": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "expected_metric": {
            "type": "string"
          },
          "patch": {
            "type": "string"
          }
        }
      }
    },
    "new_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edit_budget": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
